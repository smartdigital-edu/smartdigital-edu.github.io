# Copy to .env (local) and add the same names as GitHub Actions secrets (deploy).
# Firebase web app config: Firebase console -> Project settings -> Your apps -> Web app.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# WhatsApp number for the "Contact Us" link, international format, digits only (e.g. 60123456789).
VITE_WHATSAPP_NUMBER=

# Optional: set to "true" to force the on-device demo backend even when Firebase keys exist.
# When the Firebase keys above are empty the app runs in demo mode automatically
# (demo login: demo@kiddora.test / demo123, admin@kiddora.test / admin123).
VITE_DEMO_MODE=
