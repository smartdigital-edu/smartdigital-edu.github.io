{
  "id": "spelling",
  "title": "Spelling",
  "lesson": {
    "intro": "Good spellers [[listen]] carefully, [[say]] the word slowly, and [[break]] long words into small parts (syllables).",
    "points": [
      "Listen to each sound: c-a-t, f-i-sh.",
      "Clap the syllables: gar-den, li-bra-ry, beau-ti-ful.",
      "Learn tricky letter groups: sh (fish), ch (chair), th (three), oo (book), ee (tree), ea (eat).",
      "Look out for silent letters: k in [[k]]nife, w in [[w]]rite, h in [[h]]our.",
      "Remember spelling rules: i before e except after c (fr[[ie]]nd, rec[[ei]]ve)."
    ],
    "examples": [
      {
        "text": "scis-sors → [[scissors]]",
        "note": "double s, silent c"
      },
      {
        "text": "beau-ti-ful → [[beautiful]]",
        "note": "\"beau\" sounds like \"byoo\""
      },
      {
        "text": "fa-vour-ite → [[favourite]]",
        "note": "British/Malaysian spelling has \"our\""
      },
      {
        "text": "ne-ces-sa-ry → [[necessary]]",
        "note": "one c, double s"
      }
    ],
    "tip": "Tap \"Hear Word\" as many times as you like. Say the word quietly while you spell it."
  },
